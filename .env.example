# Public Next.js site and product API
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BRANDLENS_BACKEND_URL=http://127.0.0.1:8000
FRONTEND_ORIGIN=http://localhost:3000
APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-secret-before-deployment
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=12

# Database and background queue
DATABASE_URL=postgresql+psycopg://brandlens:brandlens@localhost:5432/brandlens
REDIS_URL=redis://localhost:6379/0

# Email. Local Docker development uses Mailpit via SMTP. Production may use Resend.
EMAIL_PROVIDER=smtp
RESEND_API_KEY=re_replace_with_your_resend_api_key
RESEND_FROM_EMAIL="BrandLens <hello@example.com>"
CONTACT_FROM_EMAIL="BrandLens <hello@example.com>"
CONTACT_TO_EMAIL=team@example.com
CONTACT_REPLY_TO=hello@example.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false

# File storage. Use local in early development or S3 for MinIO, R2 or S3.
FILE_STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./api/private-uploads
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=brandlens-private
S3_ACCESS_KEY_ID=brandlens-local
S3_SECRET_ACCESS_KEY=replace-for-deployment
S3_REGION=us-east-1
S3_SIGNED_URL_TTL_SECONDS=300
MINIO_ROOT_USER=brandlens-local
MINIO_ROOT_PASSWORD=replace-for-deployment

# AI remains off. No live provider adapter is enabled in Phase 1.
ALLOW_WORKSPACE_LLM=false
LLM_PROVIDER=mock
LLM_MODEL=mock
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1200
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=mock
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1536

# One-time account token lifetimes
VERIFICATION_TOKEN_TTL_MINUTES=60
PASSWORD_RESET_TTL_MINUTES=30
