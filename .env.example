# Public Next.js site and product API
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BRANDLENS_BACKEND_URL=http://127.0.0.1:8000
WEB_PORT=3000
# Local first-run Platform Admin. The launcher replaces the password placeholder with a random secret.
# No shared demo password is committed; retrieve the generated value from the ignored local .env.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-random-password-at-least-20-characters
# No external analytics provider is wired; events remain consent-gated and local.
FRONTEND_ORIGIN=http://localhost:3000
APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-secret-before-deployment
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_NAME=brandlens_session
SESSION_TTL_HOURS=12

# Database and background queue
DATABASE_URL=postgresql+psycopg://brandlens:brandlens@127.0.0.1:5432/brandlens
POSTGRES_PORT=5432
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PORT=6379
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
# Multiplies the source-defined endpoint quotas; keep at 1 for the documented defaults.
RATE_LIMIT_MULTIPLIER=1
# Comma-separated CIDRs for trusted reverse-proxy peers. Leave blank unless configured at the API edge.
TRUSTED_PROXY_CIDRS=

# Email. Local Docker development uses Mailpit via SMTP. Production may use Resend.
EMAIL_PROVIDER=smtp
RESEND_API_KEY=
RESEND_FROM_EMAIL="BrandLens <hello@example.com>"
CONTACT_FROM_EMAIL="BrandLens <hello@example.com>"
CONTACT_TO_EMAIL=team@example.com
CONTACT_REPLY_TO=hello@example.com
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false

# File storage. Use local in early development or S3 for MinIO, R2 or S3.
FILE_STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./private-uploads
MALWARE_SCANNER_HOST=
MALWARE_SCANNER_PORT=3310
MALWARE_SCAN_TIMEOUT_SECONDS=10
S3_ENDPOINT_URL=https://s3.example.com
S3_BUCKET=brandlens-private
S3_ACCESS_KEY_ID=replace-for-deployment
S3_SECRET_ACCESS_KEY=replace-for-deployment
S3_REGION=us-east-1
S3_SIGNED_URL_TTL_SECONDS=300

# AI remains off. No live LLM or semantic-embedding provider adapter is included.
ALLOW_WORKSPACE_LLM=false
LLM_PROVIDER=none
LLM_MODEL=none
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1200
SCAN_MAX_ASSETS=100
SCAN_MAX_CLAIMS=100
SCAN_TIMEOUT_SECONDS=300
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=none
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1536
OCR_PROVIDER=none
TESSERACT_COMMAND=
TESSERACT_TIMEOUT_SECONDS=20
# Visual palette/logo findings below this score are marked for human verification.
VISUAL_CONFIDENCE_THRESHOLD=0.65

# One-time account token lifetimes
VERIFICATION_TOKEN_TTL_MINUTES=60
PASSWORD_RESET_TTL_MINUTES=30

# Optional clean PostgreSQL integration test target (never point tests at production)
TEST_DATABASE_URL=
