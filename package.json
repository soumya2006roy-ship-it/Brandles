{
  "name": "brandlens-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "docker compose up --build",
    "build": "node scripts/check-contrast.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "contrast-check": "node scripts/check-contrast.mjs",
    "api:openapi": "python api/scripts/export_openapi.py",
    "api:types": "npm run api:openapi && openapi-typescript api/openapi.json -o app/lib/api-schema.d.ts"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.34.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
