            "type": "string",
            "title": "Id"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "role": {
            "type": "string",
            "title": "Role"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          },
          "usage_limit": {
            "type": "integer",
            "title": "Usage Limit"
          }
        },
        "type": "object",
        "required": [
          "id",
          "code",
          "role",
          "expires_at",
          "usage_limit"
        ],
        "title": "InviteResponse"
      },
