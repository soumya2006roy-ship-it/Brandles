          },
          "expires_in_days": {
            "type": "integer",
            "maximum": 30.0,
            "minimum": 1.0,
            "title": "Expires In Days",
            "default": 7
          },
          "usage_limit": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Usage Limit",
            "default": 1
          }
        },
        "type": "object",
        "required": [
          "role"
        ],
        "title": "InviteCreate"
      },
      "InviteRedeem": {
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 200,
            "minLength": 20,
